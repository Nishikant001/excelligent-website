# EmailJS configuration for the Contact Form.
# These are IDs, not secrets — EmailJS authorizes requests by allowed
# origins configured in the EmailJS dashboard, not by hiding these values.
# Still: never commit a real .env file, and set real values per environment.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
